# Centralized secrets for FindA.Sale scheduled tasks.
# Copy to .secrets.env (gitignored) and fill in. Tasks source this instead of hardcoding.
# Rotate by editing ONLY this file — no task prompt ever holds a literal again.
export GH_PAT=""              # GitHub fine-grained PAT (was hardcoded in ~task files)
export SENTRY_TOKEN=""        # Sentry auth token
export GITGUARDIAN_TOKEN=""   # GitGuardian PAT
export INTERNAL_SCRAPER_KEY="" # backend x-internal-secret / scraper key
export RAILWAY_TOKEN=""       # Railway CLI project token (keen-wisdom/production) -- used by scripts/backup-everything.ps1 for the nightly DB dump + Railway env-var export
# DB: do NOT store the password here; fetch live at runtime via `railway variables --service backend`
