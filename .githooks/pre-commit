#!/bin/sh
# FindA.Sale pre-commit hook
# Checks: no .env files staged, comprehensive secret scan on ALL staged text
# file types, and a non-blocking console.log warning for backend routes.
# Install: git config core.hooksPath .githooks (already set for pre-push)

set -e

# ── 1. Block .env files from being committed ────────────────────────────────
STAGED_ENV=$(git diff --cached --name-only | grep -E '\.env$|\.env\.' | grep -v '\.env\.example' | grep -v '\.env\.local\.example' || true)
if [ -n "$STAGED_ENV" ]; then
  echo "❌ Pre-commit blocked: .env file(s) staged for commit:"
  echo "$STAGED_ENV"
  echo "   Remove them with: git restore --staged <file>"
  exit 1
fi

# ── 2. Comprehensive secret scan across ALL staged text file types ──────────
# Scans .ts/.tsx/.js/.jsx/.py/.md/.json/.yml/.yaml/.sh/.ps1/.txt and
# extensionless files (e.g. Dockerfile). Each pattern is matched against the
# STAGED content of every candidate file. Placeholder/example lines are
# excluded. Any real match reports file + line + pattern name and BLOCKS.

PLACEHOLDER_RE='(example|sample|placeholder|your-|your_|dummy|localhost|127\.0\.0\.1|REDACTED|redacted|xxxx|XXXX|<[A-Za-z_ -]+>|CHANGEME|changeme|test_key|fake)'

# Pattern table: one "NAME|ERE" per line. Blank lines ignored.
SECRET_PATTERNS='DB-connection-string|(postgres(ql)?|mysql|mongodb(\+srv)?|redis|rediss)://[^ '"'"'"@/]+:[^ '"'"'"@/]+@
PGPASSWORD|PGPASSWORD[[:space:]]*=[[:space:]]*[^[:space:]'"'"'"]+
GitHub-PAT-classic|ghp_[A-Za-z0-9]{20,}
GitHub-PAT-fine|github_pat_[A-Za-z0-9_]{20,}
Anthropic-key|sk-ant-[A-Za-z0-9_-]{20,}
OpenAI-key|sk-[A-Za-z0-9]{20,}
Google-API-key|AIza[0-9A-Za-z_-]{30,}
Google-OAuth-secret|GOCSPX-[A-Za-z0-9_-]{10,}
AWS-access-key|AKIA[0-9A-Z]{16}
Slack-bot-token|xoxb-[A-Za-z0-9-]{10,}
Slack-user-token|xoxp-[A-Za-z0-9-]{10,}
Sentry-user-token|sntryu_[A-Za-z0-9]{20,}
GitGuardian-PAT|gg_pat_[A-Za-z0-9]{20,}
Resend-key|re_[A-Za-z0-9]{20,}
SendGrid-key|SG\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}
Stripe-live-secret|sk_live_[A-Za-z0-9]{10,}
Stripe-live-publishable|pk_live_[A-Za-z0-9]{10,}
Stripe-live-restricted|rk_live_[A-Za-z0-9]{10,}
Stripe-webhook-secret|whsec_[A-Za-z0-9]{20,}
Twilio-account-sid|AC[0-9a-f]{32}
Private-key-block|-----BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY-----
Generic-JWT|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'

HIT_FILE="${TMPDIR:-/tmp}/.findasale_secret_hit.$$"
rm -f "$HIT_FILE"

STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM || true)

for file in $STAGED_ALL; do
  case "$file" in
    *.ts|*.tsx|*.js|*.jsx|*.py|*.md|*.json|*.yml|*.yaml|*.sh|*.ps1|*.txt) ;;
    *.*) continue ;;   # extension we don't scan
    *) ;;              # extensionless — in scope
  esac

  CONTENT=$(git show ":$file" 2>/dev/null || true)
  [ -z "$CONTENT" ] && continue

  printf '%s\n' "$SECRET_PATTERNS" | while IFS='|' read -r NAME ERE; do
    [ -z "$NAME" ] && continue
    [ -z "$ERE" ] && continue
    MATCHES=$(printf '%s\n' "$CONTENT" | grep -nE -e "$ERE" 2>/dev/null | grep -viE -e "$PLACEHOLDER_RE" || true)
    if [ -n "$MATCHES" ]; then
      echo "❌ Pre-commit blocked: possible secret [$NAME] in $file"
      printf '%s\n' "$MATCHES" | while IFS= read -r line; do
        echo "     line $(printf '%s' "$line" | cut -d: -f1)"
      done
      echo "hit" >> "$HIT_FILE"
    fi
  done
done

if [ -f "$HIT_FILE" ]; then
  rm -f "$HIT_FILE"
  echo ""
  echo "   Commit blocked to prevent secret exposure."
  echo "   Replace the value with a placeholder, or load it from env, then re-stage."
  exit 1
fi

# ── 3. Warn (don't block) on unguarded console.log in backend routes/controllers ──
STAGED_CODE=$(echo "$STAGED_ALL" | grep -E '\.(ts|tsx|js|jsx)$' || true)
BACKEND_STAGED=$(echo "$STAGED_CODE" | grep -E 'packages/backend/src/(routes|controllers)/' || true)
if [ -n "$BACKEND_STAGED" ]; then
  for file in $BACKEND_STAGED; do
    if git show ":$file" 2>/dev/null | grep -n 'console\.log' | grep -qv 'NODE_ENV\|DEV\|debug\|✅\|❌\|⚠️'; then
      echo "⚠️  Warning: unguarded console.log found in $file"
      echo "   Consider wrapping with: if (process.env.NODE_ENV !== 'production')"
    fi
  done
fi


# ── 4. Public Repo Discipline guard — claude_docs/ + legal-risk narrative + real infra hostnames ──
# See CLAUDE.md §10d. Blocks re-introduction of internal docs or risk-admission
# narrative into this public repo, and blocks accidentally-committed real
# infra hostnames (Cloudflare Worker subdomains) outside placeholder form.
# Origin: S1145 (2026-07-21) — claude_docs/ was fully tracked+pushed to this
# public repo for months; a real Worker hostname was also hardcoded in a test
# script comment. This guard makes that recurrence impossible to do silently.

CLAUDE_DOCS_STAGED=$(echo "$STAGED_ALL" | grep -E '^claude_docs/' || true)
if [ -n "$CLAUDE_DOCS_STAGED" ]; then
  echo "❌ Pre-commit blocked: claude_docs/ path(s) staged — this directory is intentionally untracked (CLAUDE.md §10d):"
  echo "$CLAUDE_DOCS_STAGED"
  echo "   If this is genuinely intentional, resolve with Patrick + findasale-records first — do not force-add."
  echo "hit" >> "$HIT_FILE"
fi

NARRATIVE_PATTERNS='Risk-admission-narrative|never formally resolved
Risk-admission-narrative|shipped anyway
Risk-admission-narrative|flagged CRITICAL
Risk-admission-narrative|ToS PROHIBITED.{0,80}(Facebook|Municibid|IronPlanet|GovDeals|Proxibid|Liquidity Services|Ritchie Bros)
Real-worker-hostname|[a-z0-9][a-z0-9-]*\.workers\.dev'

WORKER_PLACEHOLDER_RE='(your-worker|<worker>|<your-worker>|example-worker|my-worker)\.workers\.dev'

for file in $STAGED_ALL; do
  case "$file" in
    *.ts|*.tsx|*.js|*.jsx|*.py|*.md|*.json|*.yml|*.yaml|*.sh|*.ps1|*.txt) ;;
    *.*) continue ;;
    *) ;;
  esac

  CONTENT=$(git show ":$file" 2>/dev/null || true)
  [ -z "$CONTENT" ] && continue

  printf '%s\n' "$NARRATIVE_PATTERNS" | while IFS='|' read -r NAME ERE; do
    [ -z "$NAME" ] && continue
    [ -z "$ERE" ] && continue
    MATCHES=$(printf '%s\n' "$CONTENT" | grep -niE -e "$ERE" 2>/dev/null || true)
    if [ "$NAME" = "Real-worker-hostname" ] && [ -n "$MATCHES" ]; then
      MATCHES=$(printf '%s\n' "$MATCHES" | grep -viE -e "$WORKER_PLACEHOLDER_RE" || true)
    fi
    if [ -n "$MATCHES" ]; then
      echo "❌ Pre-commit blocked: possible public-repo-sensitive content [$NAME] in $file"
      printf '%s\n' "$MATCHES" | while IFS= read -r line; do
        echo "     line $(printf '%s' "$line" | cut -d: -f1)"
      done
      echo "hit" >> "$HIT_FILE"
    fi
  done
done

echo "✅ Pre-commit checks passed."
exit 0
