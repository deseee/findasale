JWT_SECRET=your_key_here
STRIPE_SECRET_KEY=your_key_here
STRIPE_PUBLISHABLE_KEY=your_key_here
STRIPE_WEBHOOK_SECRET=your_key_here
RESEND_API_KEY=your_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
TWILIO_ACCOUNT_SID=your_key_here
TWILIO_AUTH_TOKEN=your_key_here
TWILIO_PHONE_NUMBER=+15555555555
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_key_here
CLOUDINARY_API_SECRET=your_key_here
# AI Image Tagger — set HF_TOKEN to activate RAM++ (Recognize Anything Plus) model
# Get a free token at https://huggingface.co/settings/tokens
# Leave blank to use simulation mode
HF_TOKEN=

# Refund clawback on destination (Connect) charges. When true, organizer-initiated
# refunds also reverse the organizer's transfer and refund the platform fee, so the
# platform is not left funding the whole refund. Automatic fraud/concurrent-purchase
# refunds always do this regardless of the flag. Leave false until organizers have
# been told, because it changes what lands in their account.
STRIPE_REFUND_LIVE_CLAWBACK=false
