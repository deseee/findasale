{
  "ci": {
    "collect": {
      "url": [
        "https://finda.sale/",
        "https://finda.sale/pricing",
        "https://finda.sale/map",
        "https://finda.sale/estate-sales/denver-co"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance":    ["warn", { "minScore": 0.6, "aggregationMethod": "median-run" }],
        "categories:accessibility":  ["warn", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["warn", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:seo":            ["warn", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "largest-contentful-paint":  ["warn", { "maxNumericValue": 4000, "aggregationMethod": "median-run" }],
        "total-blocking-time":       ["warn", { "maxNumericValue": 600,  "aggregationMethod": "median-run" }],
        "cumulative-layout-shift":   ["warn", { "maxNumericValue": 0.1,  "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
