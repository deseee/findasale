# Local dev: http://localhost:5000/api | Production: https://api.finda.sale/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_key_here

# PWA Push Notifications — must match VAPID_PUBLIC_KEY in backend .env
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Sentry error monitoring — get DSN from sentry.io → project settings
NEXT_PUBLIC_SENTRY_DSN=

# Cloudflare Turnstile CAPTCHA site key — REQUIRED for the /register page (P0 fix, 2026-07-18).
# Must match TURNSTILE_SECRET_KEY set in backend .env / Railway. Get both from a free Cloudflare
# Turnstile site at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Region Configuration ──────────────────────────────────────────────────
# Frontend-accessible region settings. Defaults to Grand Rapids, MI.
NEXT_PUBLIC_DEFAULT_CITY=Grand Rapids
NEXT_PUBLIC_DEFAULT_STATE=MI
NEXT_PUBLIC_MAP_CENTER_LAT=42.9634
NEXT_PUBLIC_MAP_CENTER_LNG=-85.6681
# Google Analytics 4 — get from analytics.google.com → Admin → Data Streams → Web → Measurement ID
# Leave blank (or omit) to disable GA entirely
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Server-only (never NEXT_PUBLIC_ — not exposed to the client) ──────────
# Shared secret for on-demand ISR revalidation (ADR 2026-07-11). Gates
# POST /api/revalidate, called by the backend after real data changes so
# /sales/[id] and /city/[slug] pages update immediately instead of waiting
# on the blanket time-based ISR fallback. Must match REVALIDATE_SECRET set
# on Railway (backend). NEW as of 2026-07-11 — not yet set anywhere. Generate
# a random value and set it on both Vercel (this var) and Railway before this
# is testable end-to-end.
REVALIDATE_SECRET=your_secret_here
