# Local dev: http://localhost:5000/api | Production: https://api.finda.sale/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_key_here

# Square Web Payments SDK -- phone-based POS (Square migration Wave 1 #3, 2026-09-07).
# applicationId is the Square Developer Console app id (NOT a secret -- safe client-side,
# same trust level as the Stripe publishable key above). Get it from
# developer.squareup.com/apps -> your app -> Credentials.
NEXT_PUBLIC_SQUARE_APPLICATION_ID=your_square_application_id_here
# 'sandbox' or unset/anything else = production. Must match backend SQUARE_ENVIRONMENT
# (packages/backend/.env) so the SDK's card token and the server's CreatePayment call
# target the same Square environment.
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
# FindA.Sale's own platform Square location id (same value as the backend's
# SQUARE_PLATFORM_LOCATION_ID env var, packages/backend/.env -- Developer Console ->
# Locations). Location ids are not secret (same trust level as applicationId above).
# Needed for any Web Payments SDK card form that charges the PLATFORM directly rather
# than a connected organizer -- currently just the boost purchase cash rail
# (components/BoostPurchaseModal.tsx).
NEXT_PUBLIC_SQUARE_PLATFORM_LOCATION_ID=your_square_platform_location_id_here

# PWA Push Notifications — must match VAPID_PUBLIC_KEY in backend .env
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Sentry error monitoring — get DSN from sentry.io → project settings
NEXT_PUBLIC_SENTRY_DSN=

# ── Region Configuration ──────────────────────────────────────────────────
# Frontend-accessible region settings. Defaults to Grand Rapids, MI.
NEXT_PUBLIC_DEFAULT_CITY=Grand Rapids
NEXT_PUBLIC_DEFAULT_STATE=MI
NEXT_PUBLIC_MAP_CENTER_LAT=42.9634
NEXT_PUBLIC_MAP_CENTER_LNG=-85.6681
# Google Analytics 4 — get from analytics.google.com → Admin → Data Streams → Web → Measurement ID
# Leave blank (or omit) to disable GA entirely
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Server-only (never NEXT_PUBLIC_ — not exposed to the client) ──────────
# Shared secret for on-demand ISR revalidation (ADR 2026-07-11). Gates
# POST /api/revalidate, called by the backend after real data changes so
# /sales/[id] and /city/[slug] pages update immediately instead of waiting
# on the blanket time-based ISR fallback. Must match REVALIDATE_SECRET set
# on Railway (backend). NEW as of 2026-07-11 — not yet set anywhere. Generate
# a random value and set it on both Vercel (this var) and Railway before this
# is testable end-to-end.
REVALIDATE_SECRET=your_secret_here
