# real backend changes for #602/#603 landed in commit 98fc4a57a, but the next two pushes
# (a6d56f9f9, a15ac32e) were frontend-only fixes -- Railway evaluated watchPatterns against
# those push tips and SKIPPED the backend deploy both times (confirmed via Railway MCP
# list-deployments: both show status=SKIPPED). Backend has been running commit f871e74f3
# (pre-#602/#603) the whole time -- confirmed live: GET /api/extension/sync-health returned
# a real 404 "Not found" against the Railway domain directly, while the sibling route
# /api/extension/items correctly returned 401 (route exists, route in question does not).
# This trivial change touches packages/backend/** to force a fresh deploy that will pick up
# all currently-committed backend code.
FROM node:20-slim AS base

# Install OpenSSL for Prisma
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@9.1.0 --activate

WORKDIR /app

# --- deps stage ---
FROM base AS deps

# Skip Puppeteer Chrome download — we use system Chromium in the runner stage
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Copy workspace manifests first for caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/backend/package.json ./packages/backend/
COPY packages/database/package.json ./packages/database/
COPY packages/shared/package.json ./packages/shared/

RUN pnpm install --frozen-lockfile

# --- builder stage ---
FROM base AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/backend/node_modules ./packages/backend/node_modules
COPY --from=deps /app/packages/database/node_modules ./packages/database/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules

COPY . .

# Generate Prisma client (writes into node_modules/.pnpm virtual store)
RUN cd packages/database && npx prisma generate

# Typecheck gate ENFORCED: backend tsc is at 0 project errors (verified against a freshly
# regenerated Prisma client; tsconfig has skipLibCheck). A non-zero tsc exit ABORTS the build.
# tsc also emits the JS to dist/. The scraper type-debt referenced in earlier revisions is cleared.
RUN cd packages/backend && npx tsc

# Build completeness gate: fail Docker build if tsc OOM'd and produced <75% of source files
# Prevents a partial dist/ from being deployed when the builder runs out of memory.
RUN cd packages/backend && \
    SRC=$(find src -name "*.ts" ! -path "*/__tests__/*" | wc -l) && \
    OUT=$(find dist -name "*.js" | wc -l) && \
    MIN=$((SRC * 3 / 4)) && \
    echo "[build-check] tsc emitted $OUT JS from $SRC TS (min: $MIN)" && \
    [ "$OUT" -ge "$MIN" ] || { echo "FATAL: tsc produced only $OUT/$SRC files — OOM or partial build"; exit 1; }

# --- runner stage ---
FROM node:20-slim AS runner

# Install OpenSSL (Prisma) + Chromium (Puppeteer label printing) + ffmpeg (video
# assembly/caption burn-in, ADR-078 Addendum 2) + curl/ca-certificates (fetch the
# free Piper TTS binary + voice model at build time, both from public,
# unauthenticated sources — no API key, no account)
RUN apt-get update -y && apt-get install -y \
  openssl \
  chromium \
  ffmpeg \
  curl \
  ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.1.0 --activate

WORKDIR /app

# node_modules includes .pnpm virtual store which contains the regenerated Prisma client
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/backend/node_modules ./packages/backend/node_modules
COPY --from=builder /app/packages/database/node_modules ./packages/database/node_modules
COPY --from=builder /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=builder /app/packages/backend/dist ./packages/backend/dist
COPY --from=builder /app/packages/database/prisma ./packages/database/prisma
COPY --from=builder /app/packages/backend/package.json ./packages/backend/
COPY --from=builder /app/packages/database/package.json ./packages/database/
COPY --from=builder /app/packages/shared/package.json ./packages/shared/

# --- ADR-078 Addendum 2: free/self-hosted video pipeline tooling ---
# JSON2Video ($49/mo) + ZapCap ($0.10/min) were REJECTED by Patrick outright
# (no new recurring paid vendor spend, standing rule). Everything below is
# free, self-hosted, and pulled from public/unauthenticated sources at build
# time so a normal `git push` + Railway auto-deploy produces a working
# pipeline with zero manual setup for Patrick — no API keys, no accounts.

# Piper TTS (https://github.com/rhasspy/piper, MIT license) — a prebuilt static
# binary from a public GitHub release, plus one voice model (ONNX + config)
# from the public Hugging Face repo rhasspy/piper-voices. Verified this session:
# piping text into this exact binary+model produces real, playable WAV audio.
RUN mkdir -p /opt/piper && \
    curl -fSL --http1.1 --retry 5 --retry-all-errors --retry-delay 3 \
      -o /tmp/piper.tar.gz \
      https://github.com/rhasspy/piper/releases/download/2023.11.14-2/piper_linux_x86_64.tar.gz && \
    tar -xz -C /opt -f /tmp/piper.tar.gz && rm -f /tmp/piper.tar.gz && \
    mkdir -p /opt/piper/voices && \
    curl -fSL --http1.1 --retry 5 --retry-all-errors --retry-delay 3 -o /opt/piper/voices/en_US-amy-medium.onnx \
      https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/amy/medium/en_US-amy-medium.onnx && \
    curl -fSL --http1.1 --retry 5 --retry-all-errors --retry-delay 3 -o /opt/piper/voices/en_US-amy-medium.onnx.json \
      https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/amy/medium/en_US-amy-medium.onnx.json

ENV PIPER_BIN_PATH=/opt/piper/piper
ENV PIPER_MODEL_PATH=/opt/piper/voices/en_US-amy-medium.onnx
ENV PIPER_LIB_DIR=/opt/piper
ENV LD_LIBRARY_PATH=/opt/piper

# Whisper STT (Xenova/whisper-tiny.en via @xenova/transformers, Apache-2.0,
# public unauthenticated Hugging Face repo, no API key) — pre-warm the model
# into the image now so captioning.ts never makes a network call for it at
# runtime. warm-whisper-cache.mjs is a plain ESM script (the package is
# ESM-only) copied from the builder stage's full repo checkout.
COPY --from=builder /app/packages/backend/scripts/warm-whisper-cache.mjs ./packages/backend/scripts/warm-whisper-cache.mjs
ENV WHISPER_CACHE_DIR=/opt/whisper-cache
RUN node packages/backend/scripts/warm-whisper-cache.mjs

# PaddleOCR caption engine (ppu-paddle-ocr, PP-OCRv6 small .ort models, MIT,
# public unauthenticated source, no API key) — ADR-080 §5.1. Pre-warm the models
# into ~/.cache/ppu-paddle-ocr so clipAnalysisService.ts makes no network call at
# runtime (mirrors the Whisper warm-up above). Non-fatal: the service downloads
# lazily on first real clip-analysis job if this step is skipped or flakes.
COPY --from=builder /app/packages/backend/scripts/warm-paddle-ocr-cache.mjs ./packages/backend/scripts/warm-paddle-ocr-cache.mjs
RUN node packages/backend/scripts/warm-paddle-ocr-cache.mjs
# --- end ADR-078 Addendum 2 additions ---

# Set Puppeteer to use system Chromium
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app/packages/backend

ENV NODE_ENV=production

EXPOSE 3001

CMD ["node", "dist/index.js"]
