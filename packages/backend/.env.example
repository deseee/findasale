PORT=5000

# Local dev: http://localhost:3000 | Production: https://finda.sale
FRONTEND_URL=https://finda.sale

# Comma-separated. Local dev: http://localhost:3000 | Production: https://finda.sale
ALLOWED_ORIGINS=https://finda.sale

JWT_SECRET=your_key_here
DATABASE_URL=your_key_here
# Direct connection for migrations (Railway)
DIRECT_URL=your_key_here
# Local dev database (optional)
LOCAL_DATABASE_URL=your_key_here

STRIPE_SECRET_KEY=your_key_here
STRIPE_PUBLISHABLE_KEY=your_key_here
# Get from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=your_key_here
# Get from Stripe Dashboard → Webhooks → your billing endpoint → Signing secret
STRIPE_BILLING_WEBHOOK_SECRET=your_key_here
# Get from Stripe Dashboard → Webhooks → your Connect endpoint → Signing secret
STRIPE_CONNECT_WEBHOOK_SECRET=your_key_here
# Get from Stripe Dashboard → Products → your PRO/TEAMS plan → Prices
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_TEAMS_MONTHLY_PRICE_ID=price_...
# Get from Stripe Dashboard → Products → generic item product → ID
STRIPE_GENERIC_ITEM_PRODUCT_ID=prod_...
# Get from Stripe Dashboard → Products → Hunt Pass subscription → Price ID
STRIPE_HUNT_PASS_PRICE_ID=price_...
# Optional: coupon ID for trial periods (Stripe Dashboard → Coupons)
STRIPE_TRIAL_COUPON_ID=
# Set to "true" to use Stripe Terminal in simulated mode (dev/staging only — never in production)
NEXT_PUBLIC_STRIPE_TERMINAL_SIMULATED=false

RESEND_API_KEY=your_key_here
RESEND_FROM_EMAIL=example@resend.dev
# Read-enabled Resend key (logs/emails API) used by the daily email-delivery-health check (M2).
RESEND_ADMIN_API_KEY=your_read_key_here

# Email recipient policy (S937): we NEVER send to our own domain zone — any recipient at
# finda.sale or *.finda.sale (e.g. scraped placeholders scraper+slug@system.finda.sale) is
# filtered at the email rails (suppressionService.isEmailDomainBlocked). The ONLY allowed
# exception is the contact-form support inbox (SUPPORT_EMAIL, default support@finda.sale).
# If you ever stand up another REAL internal finda.sale inbox you want to email FROM the app
# (e.g. info@ or patrick@), add it here as a comma-separated allowlist — otherwise it will be
# blocked by the zone filter. Leave blank if unused.
SENDABLE_FINDA_SALE_ADDRESSES=
SUPPORT_EMAIL=support@finda.sale

# MailerLite — organizer onboarding automation
# API token (used by MailerLite SDK): MailerLite → Integrations → MailerLite API
MAILERLITE_API_TOKEN=your_key_here
# API key (used by direct HTTP requests in some services — same credential, different header)
MAILERLITE_API_KEY=your_key_here
# Get from: MailerLite → Subscribers → Groups → your shopper group → ID in URL
MAILERLITE_SHOPPERS_GROUP_ID=your_group_id_here

TWILIO_ACCOUNT_SID=your_key_here
TWILIO_AUTH_TOKEN=your_key_here
TWILIO_PHONE_NUMBER=+15555555555

CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
# Used for bandwidth cost tracking — average compressed image size in KB
CLOUDINARY_AVG_IMAGE_SIZE_KB=200

# ── AI Tagging — CB1 (Cloud AI path, preferred) ───────────────────────────────────────
# Google Cloud Vision API: console.cloud.google.com → APIs → Vision API → Credentials → API Key
GOOGLE_VISION_API_KEY=your_key_here
# Anthropic API: console.anthropic.com → API Keys → Create key
ANTHROPIC_API_KEY=your_key_here
# Max AI spend per billing cycle in USD before fallback to local model
AI_COST_CEILING_USD=0.25
# Local AI fallback via Ollama (optional — omit to disable)
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava
# PWA Push Notifications (web-push)
# Generate keys: npx web-push generate-vapid-keys
# Add NEXT_PUBLIC_VAPID_PUBLIC_KEY to frontend .env too
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=admin@finda.sale

# Sentry error monitoring — get DSN from sentry.io → project settings
SENTRY_DSN=
# Sentry auth token for source map uploads (sentry.io → Settings → Auth Tokens)
SENTRY_AUTH_TOKEN=

# ── Integrations ────────────────────────────────────────────────────────
# Google Places API — used for address autocomplete
GOOGLE_PLACES_API_KEY=
# eBay marketplace notifications (deletion endpoint must be registered in eBay Developer portal)
EBAY_DELETION_ENDPOINT_URL=
EBAY_VERIFICATION_TOKEN=
# OSRM self-hosted routing (optional — for Treasure Trails distance calculations)
OSRM_API_URL=

# ── Internal API Authentication ──────────────────────────────────────────
# Shared secret for internal routes (requireSecret middleware, x-internal-secret header)
# Used by: /api/internal/scraper/enrich-backfill, licensing scrapers, outreach trigger
# Railway-only secret — not needed for local dev. Set in Railway env vars + GitHub Actions secrets.
OUTREACH_SECRET=your_secret_here
# Shared key for GitHub Actions scraper ingestion (x-scraper-key header)
# Used by: /api/internal/scraper/ingest, geocoding, sale detail enrichment
# Railway-only secret — not needed for local dev. Set in Railway env vars + GitHub Actions secrets.
INTERNAL_SCRAPER_KEY=your_key_here

# ── Security ─────────────────────────────────────────────────────────────
# Comma-separated IPs exempt from rate limiting (e.g. Railway health checks)
RATE_LIMIT_WHITELIST_IPS=

# ── Region Configuration ────────────────────────────────────────────────
# Allows the app to serve any city/region by changing env vars at deployment time.
# Defaults to Grand Rapids, MI for existing deployments.
DEFAULT_CITY=Grand Rapids
DEFAULT_STATE=Michigan
DEFAULT_STATE_ABBREV=MI
DEFAULT_LAT=42.9619
DEFAULT_LNG=-85.6789
DEFAULT_RADIUS_MILES=25
DEFAULT_COUNTY=Kent County
DEFAULT_TIMEZONE=America/Detroit

# ── Search Engine Indexing ───────────────────────────────────────────────
# IndexNow API key — must match /public/fa3d9e1b8c2047a6d5f3e9b1c4a87d20.txt on the frontend
INDEX_NOW_KEY=fa3d9e1b8c2047a6d5f3e9b1c4a87d20

# ── Auth (additional) ─────────────────────────────────────────────────────────
JWT_REFRESH_SECRET=                    # Must be set — distinct from JWT_SECRET. If absent, refresh tokens fall back to JWT_SECRET (defeats token rotation)

# ── eBay Integration ─────────────────────────────────────────────────────────
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_OAUTH_REDIRECT_URI=
EBAY_API_DAILY_LIMIT=500              # Daily cap on eBay API calls per cron
EBAY_PROXY_SECRET=                    # Shared secret for eBay proxy service

# ── Gmail Outreach Rail ───────────────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=                  # Outreach account refresh token
GMAIL_MAILBOX_REFRESH_TOKEN=          # Support mailbox refresh token
GMAIL_FROM_EMAIL=
GMAIL_DAILY_HARD_LIMIT=100           # Max emails/day via Gmail rail

# ── Email Feature Flags ───────────────────────────────────────────────────────
OUTREACH_ENABLED=false               # Set true to enable organizer outreach emails
EMAIL_DISCOVERY_ENABLED=false        # Set true to enable email discovery scraper

# ── Third-Party Scrapers ─────────────────────────────────────────────────────
FB_MARKETPLACE_PROXY_URL=            # Proxy URL for Facebook Marketplace scraper
FB_MARKETPLACE_PROXY_TOKEN=          # Auth token for FB Marketplace proxy
DISCOGS_TOKEN=                       # Discogs API token for vinyl/music comps
FOURSQUARE_API_KEY=                  # Foursquare API for venue data
BRAVE_API_KEY=                       # Brave Search API for scraper enrichment

# ── AI / ML ──────────────────────────────────────────────────────────────────
ANTHROPIC_MODEL=claude-haiku-4-5-20251001   # Model string override (defaults to haiku)

# ── Infrastructure ────────────────────────────────────────────────────────────
BACKEND_URL=                         # Internal URL for backend (used in scraper callbacks)
EBTH_WORKER_URL=                     # EBTH worker service URL

# ── Feature / Scraper Flags ───────────────────────────────────────────────────
CATEGORY_SYNC_ENABLED=false          # Enable eBay category sync cron
DISABLE_ORGANIZER_WEBSITE_ENRICHMENT=false   # Disable website enrichment during scraping
