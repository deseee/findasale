PORT=5000

# Local dev: http://localhost:3000 | Production: https://finda.sale
FRONTEND_URL=https://finda.sale

# Comma-separated. Local dev: http://localhost:3000 | Production: https://finda.sale
ALLOWED_ORIGINS=https://finda.sale

JWT_SECRET=your_key_here
DATABASE_URL=your_key_here
# Direct connection for migrations (Railway)
DIRECT_URL=your_key_here
# Local dev database (optional)
LOCAL_DATABASE_URL=your_key_here

STRIPE_SECRET_KEY=your_key_here
STRIPE_PUBLISHABLE_KEY=your_key_here
# Get from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=your_key_here
# Get from Stripe Dashboard → Webhooks → your billing endpoint → Signing secret
STRIPE_BILLING_WEBHOOK_SECRET=your_key_here
# Get from Stripe Dashboard → Webhooks → your Connect endpoint → Signing secret
STRIPE_CONNECT_WEBHOOK_SECRET=your_key_here
# Get from Stripe Dashboard → Products → your PRO/TEAMS plan → Prices
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_TEAMS_MONTHLY_PRICE_ID=price_...
# Get from Stripe Dashboard → Products → generic item product → ID
STRIPE_GENERIC_ITEM_PRODUCT_ID=prod_...
# Get from Stripe Dashboard → Products → Hunt Pass subscription → Price ID
STRIPE_HUNT_PASS_PRICE_ID=price_...
# Optional: coupon ID for trial periods (Stripe Dashboard → Coupons)
STRIPE_TRIAL_COUPON_ID=
# Set to "true" to use Stripe Terminal in simulated mode (dev/staging only — never in production)
NEXT_PUBLIC_STRIPE_TERMINAL_SIMULATED=false

RESEND_API_KEY=your_key_here
RESEND_FROM_EMAIL=example@resend.dev
# Read-enabled Resend key (logs/emails API) used by the daily email-delivery-health check (M2).
RESEND_ADMIN_API_KEY=your_read_key_here

# Email recipient policy (S937): we NEVER send to our own domain zone — any recipient at
# finda.sale or *.finda.sale (e.g. scraped placeholders scraper+slug@system.finda.sale) is
# filtered at the email rails (suppressionService.isEmailDomainBlocked). The ONLY allowed
# exception is the contact-form support inbox (SUPPORT_EMAIL, default support@finda.sale).
# If you ever stand up another REAL internal finda.sale inbox you want to email FROM the app
# (e.g. info@ or patrick@), add it here as a comma-separated allowlist — otherwise it will be
# blocked by the zone filter. Leave blank if unused.
SENDABLE_FINDA_SALE_ADDRESSES=
SUPPORT_EMAIL=support@finda.sale

# MailerLite — organizer onboarding automation
# API token (used by MailerLite SDK): MailerLite → Integrations → MailerLite API
MAILERLITE_API_TOKEN=your_key_here
# API key (used by direct HTTP requests in some services — same credential, different header)
MAILERLITE_API_KEY=your_key_here
# Get from: MailerLite → Subscribers → Groups → your shopper group → ID in URL
MAILERLITE_SHOPPERS_GROUP_ID=your_group_id_here

TWILIO_ACCOUNT_SID=your_key_here
TWILIO_AUTH_TOKEN=your_key_here
TWILIO_PHONE_NUMBER=+15555555555

CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
# Used for bandwidth cost tracking — average compressed image size in KB
CLOUDINARY_AVG_IMAGE_SIZE_KB=200

# ── AI Tagging — CB1 (Cloud AI path, preferred) ───────────────────────────────────────
# Google Cloud Vision API: console.cloud.google.com → APIs → Vision API → Credentials → API Key
GOOGLE_VISION_API_KEY=your_key_here
# Anthropic API: console.anthropic.com → API Keys → Create key
ANTHROPIC_API_KEY=your_key_here
# Max AI spend per billing cycle in USD before fallback to local model
AI_COST_CEILING_USD=0.25
# Local AI fallback via Ollama (optional — omit to disable)
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava
# Reverse-Image Product Index (ADR 2026-07-01) — self-hosted Marqo-Ecommerce-B
# embedding service. Default OFF until the Open Images reference corpus is built
# (scripts/open-images/extract_open_images.py + ingestOpenImagesCorpus.ts).
# CATALOG_MATCH_ENABLED=true
# MARQO_EMBED_URL=https://<your-marqo-embed-service>.up.railway.app

# Google Vision Web Detection — hard-gated, default OFF (ADR-web-detection-hard-gating-2026-07-01)
# Do NOT set to true until the GCP Console quota check in that ADR's "Flagged for Patrick"
# section has been done. Three independent stops: kill switch below, dedicated monthly cost
# ceiling, dedicated daily call cap — see aiCostTracker.ts for details.
# WEB_DETECTION_ENABLED=true
# WEB_DETECTION_COST_CEILING_USD=5
# WEB_DETECTION_DAILY_CAP=200

# eBay searchByImage catalog-match evidence — free (client-credentials Browse quota), default OFF
# (ADR-ebay-searchbyimage-tagging-2026-07-02). Kill switch below + a daily CALL cap that protects
# the shared ~5k/day Browse quota price comps also use. No dollar ceiling — the call costs nothing.
# PRODUCTION-ONLY (searchByImage has no Sandbox). Reuses EBAY_CLIENT_ID/SECRET already configured.
# EBAY_IMAGE_SEARCH_ENABLED=true
# EBAY_IMAGE_SEARCH_DAILY_CAP=500
# PWA Push Notifications (web-push)
# Generate keys: npx web-push generate-vapid-keys
# Add NEXT_PUBLIC_VAPID_PUBLIC_KEY to frontend .env too
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=admin@finda.sale

# Sentry error monitoring — get DSN from sentry.io → project settings
SENTRY_DSN=
# Sentry auth token for source map uploads (sentry.io → Settings → Auth Tokens)
SENTRY_AUTH_TOKEN=

# ── Integrations ────────────────────────────────────────────────────────
# Google Places API — used for address autocomplete
GOOGLE_PLACES_API_KEY=
# eBay marketplace notifications (deletion endpoint must be registered in eBay Developer portal)
EBAY_DELETION_ENDPOINT_URL=
EBAY_VERIFICATION_TOKEN=
# OSRM self-hosted routing (optional — for Treasure Trails distance calculations)
OSRM_API_URL=

# ── Internal API Authentication ──────────────────────────────────────────
# Shared secret for internal routes (requireSecret middleware, x-internal-secret header)
# Used by: /api/internal/scraper/enrich-backfill, licensing scrapers, outreach trigger
# Railway-only secret — not needed for local dev. Set in Railway env vars + GitHub Actions secrets.
OUTREACH_SECRET=your_secret_here
# Shared key for GitHub Actions scraper ingestion (x-scraper-key header)
# Used by: /api/internal/scraper/ingest, geocoding, sale detail enrichment
# Railway-only secret — not needed for local dev. Set in Railway env vars + GitHub Actions secrets.
INTERNAL_SCRAPER_KEY=your_key_here

# ── Security ─────────────────────────────────────────────────────────────
# Comma-separated IPs exempt from rate limiting (e.g. Railway health checks)
RATE_LIMIT_WHITELIST_IPS=

# ── Region Configuration ────────────────────────────────────────────────
# Allows the app to serve any city/region by changing env vars at deployment time.
# Defaults to Grand Rapids, MI for existing deployments.
DEFAULT_CITY=Grand Rapids
DEFAULT_STATE=Michigan
DEFAULT_STATE_ABBREV=MI
DEFAULT_LAT=42.9619
DEFAULT_LNG=-85.6789
DEFAULT_RADIUS_MILES=25
DEFAULT_COUNTY=Kent County
DEFAULT_TIMEZONE=America/Detroit

# ── Search Engine Indexing ───────────────────────────────────────────────
# IndexNow API key — must match /public/fa3d9e1b8c2047a6d5f3e9b1c4a87d20.txt on the frontend
INDEX_NOW_KEY=fa3d9e1b8c2047a6d5f3e9b1c4a87d20

# ── Auth (additional) ─────────────────────────────────────────────────────────
JWT_REFRESH_SECRET=                    # Must be set — distinct from JWT_SECRET. If absent, refresh tokens fall back to JWT_SECRET (defeats token rotation)

# ── eBay Integration ─────────────────────────────────────────────────────────
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_OAUTH_REDIRECT_URI=
EBAY_API_DAILY_LIMIT=500              # Daily cap on eBay API calls per cron
EBAY_PROXY_SECRET=                    # Shared secret for eBay proxy service

# ── Gmail Outreach Rail ───────────────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=                  # Outreach account refresh token
GMAIL_MAILBOX_REFRESH_TOKEN=          # Support mailbox refresh token
GMAIL_FROM_EMAIL=
GMAIL_DAILY_HARD_LIMIT=100           # Max emails/day via Gmail rail

# ── Email Feature Flags ───────────────────────────────────────────────────────
OUTREACH_ENABLED=false               # Set true to enable organizer outreach emails
EMAIL_DISCOVERY_ENABLED=false        # Set true to enable email discovery scraper

# ── Third-Party Scrapers ─────────────────────────────────────────────────────
FB_MARKETPLACE_PROXY_URL=            # Proxy URL for Facebook Marketplace scraper
FB_MARKETPLACE_PROXY_TOKEN=          # Auth token for FB Marketplace proxy
DISCOGS_TOKEN=                       # Discogs API token for vinyl/music comps
FOURSQUARE_API_KEY=                  # Foursquare API for venue data
BRAVE_API_KEY=                       # Brave Search API for scraper enrichment

# ── AI / ML ──────────────────────────────────────────────────────────────────
ANTHROPIC_MODEL=claude-haiku-4-5-20251001   # Model string override (defaults to haiku)

# ── Infrastructure ────────────────────────────────────────────────────────────
BACKEND_URL=                         # Internal URL for backend (used in scraper callbacks)
EBTH_WORKER_URL=                     # EBTH worker service URL

# ── Feature / Scraper Flags ───────────────────────────────────────────────────
CATEGORY_SYNC_ENABLED=false          # Enable eBay category sync cron
DISABLE_ORGANIZER_WEBSITE_ENRICHMENT=false   # Disable website enrichment during scraping
# ── Stripe Pricing / Connect (additional) ────────────────────────────────────
# Test-mode secret key — used by scripts/tests that must not touch live Stripe (Stripe Dashboard → Test mode → API keys)
STRIPE_TEST_SECRET_KEY=
# Get from Stripe Dashboard → Products → PRO plan → Prices → Annual price
STRIPE_PRO_ANNUAL_PRICE_ID=
# Get from Stripe Dashboard → Products → TEAMS plan → Prices → Annual price
STRIPE_TEAMS_ANNUAL_PRICE_ID=
# Get from Stripe Dashboard → Products → TEAMS plan → Prices → Per-seat price
STRIPE_TEAMS_SEAT_PRICE_ID=
# Set to "true" to allow real (non-simulated) Stripe Connect transfers to organizers
STRIPE_CONNECT_LIVE_TRANSFERS=false
# Stripe Connect partner/platform ID (Stripe Dashboard → Connect → Settings)
STRIPE_PARTNER_ID=
# Backend-side mirror of NEXT_PUBLIC_STRIPE_TERMINAL_SIMULATED — set "true" only in dev/staging
STRIPE_TERMINAL_SIMULATED=false

# ── Security / Webhooks (additional) ─────────────────────────────────────────
# Shared secret that lets QA bypass rate limiting on auth endpoints during automated testing — Railway/CI only, never local
QA_RATE_LIMIT_BYPASS_SECRET=
# Get from Resend Dashboard → Webhooks → your endpoint → Signing secret (used for delivery/bounce webhook verification)
RESEND_WEBHOOK_SECRET=
# WebAuthn/passkey Relying Party ID — must match the site's registrable domain (e.g. finda.sale)
WEBAUTHN_RP_ID=
# WebAuthn/passkey expected origin — full scheme+host (e.g. https://finda.sale)
WEBAUTHN_ORIGIN=
# Google service account credentials JSON (stringified) — used for model bakeoff / Vertex-style auth
GOOGLE_SERVICE_ACCOUNT_JSON=
# eBay marketplace account deletion notifications — verification token (eBay Developer Portal → Notifications)
EBAY_NOTIFICATION_VERIFICATION_TOKEN=
# eBay marketplace account deletion notifications — registered callback endpoint URL
EBAY_NOTIFICATION_ENDPOINT_URL=

# ── AI Grounding — Cost-Controlled Web-Grounded Enrichment ───────────────────
# Master kill switch for the grounding pipeline (visual + text). Default OFF.
GROUNDING_ENABLED=false
# Hard monthly spend ceiling in USD before grounding auto-disables
GROUNDING_COST_CEILING_USD=
# Max grounding calls allowed per day regardless of spend
GROUNDING_DAILY_CAP=
# Confidence threshold below which an item is escalated to a stronger grounding pass
GROUNDING_ESCALATE_BELOW=
# Max USD allowed to be spent grounding a single item before skipping
GROUNDING_PER_ITEM_COST_CEILING_USD=
# Skip re-grounding items whose existing confidence is already above this value
GROUNDING_REGROUND_SKIP_ABOVE=
# Percentage (0-100) of eligible items rolled into the grounding pipeline — for staged rollout
GROUNDING_ROLLOUT_PCT=
# Enable text-based grounding specifically (title/description enrichment), independent of visual grounding
GROUNDING_TEXT_ENABLED=false
# Model string used for the higher-cost/higher-accuracy text grounding pass
GROUNDING_TEXT_PREMIUM_MODEL=
# Model string used for the lower-cost text grounding pass (value extraction)
GROUNDING_TEXT_VALUE_MODEL=
# Model string used specifically for structured value extraction during grounding
GROUNDING_VALUE_EXTRACTOR_MODEL=
# Enable visual (image-based) grounding specifically, independent of text grounding
GROUNDING_VISUAL_ENABLED=false
# Google Vision Web Detection — hard-gated feature flag, default OFF (see ADR-web-detection-hard-gating-2026-07-01)
WEB_DETECTION_ENABLED=false
# Monthly spend ceiling in USD for Web Detection API calls
WEB_DETECTION_COST_CEILING_USD=5
# Max Web Detection API calls allowed per day
WEB_DETECTION_DAILY_CAP=200

# ── AI / ML — Additional Providers ────────────────────────────────────────────
# Google Gemini API key — used by model bakeoff service as an alternate vision/text model
GEMINI_API_KEY=
# OpenRouter API key — used by model bakeoff service to access multiple hosted models via one API
OPENROUTER_API_KEY=

# ── Pricing / Comp Data Providers ────────────────────────────────────────────
# Keepa API key — Amazon price history/comps for item valuation
KEEPA_API_KEY=
# GoUPC API key — barcode/UPC lookup for item identification
GOUPC_API_KEY=
# Yelp API key — used for venue/organizer enrichment
YELP_API_KEY=
# ScaleSERP API key — search engine results API used for price comp scraping
SCALESERP_API_KEY=
# HERE API key — places/geocoding provider used by run-here-places scraper
HERE_API_KEY=
# Socrata App Token — used for municipal open-data API rate limits (e.g. permit/business listings)
SOCRATA_APP_TOKEN=
# Searlo (Facebook Events search) requests-per-minute override — see search-facebook-events.ts for tuning notes
SEARLO_RPM=9

# ── Reverse-Image Product Index (Catalog Match) ──────────────────────────────
# Enable catalog-match embedding lookups — default OFF until the Open Images reference corpus is built
CATALOG_MATCH_ENABLED=false
# Self-hosted Marqo-Ecommerce-B embedding service URL, e.g. https://<your-marqo-embed-service>.up.railway.app
MARQO_EMBED_URL=
# Path to the candidates file used by the Open Images corpus ingestion script (scripts/open-images/extract_open_images.py)
OPEN_IMAGES_CANDIDATES_FILE=
# Path to the candidates file used by the Overture Places enrichment script (runOvertureEnrichment.ts)
OVERTURE_CANDIDATES_FILE=

# ── eBay Integration (additional) ────────────────────────────────────────────
# Enable matching by title as a fallback identifier when catalog IDs are unavailable
EBAY_MATCH_TITLE_AS_ID=false
# Daily cap on eBay searchByImage calls — protects the shared ~5k/day Browse quota (see ADR-ebay-searchbyimage-tagging-2026-07-02)
EBAY_IMAGE_SEARCH_DAILY_CAP=500
# Kill switch for eBay searchByImage catalog-match evidence — default OFF, production-only (no Sandbox support)
EBAY_IMAGE_SEARCH_ENABLED=false

# ── Outreach (additional) ─────────────────────────────────────────────────────
# From-address used for outreach sends — falls back to outreach@finda.sale
OUTREACH_FROM_EMAIL=
# When set, redirects ALL outreach sends to this address instead of real recipients (test mode)
OUTREACH_TEST_EMAIL=
# Mailbox that receives outreach bounces — falls back to find@outreach.finda.sale
OUTREACH_BOUNCE_MAILBOX=
# Date (YYYY-MM-DD) outreach warmup ramp began — used to compute the current daily send cap during ramp-up
OUTREACH_WARMUP_START_DATE=2026-05-06
# Max outreach emails allowed per day (post-warmup steady state)
OUTREACH_DAILY_CAP=75
# Set "true" to include Canadian organizers in outreach targeting (default excludes Canada)
OUTREACH_CANADA_ENABLED=false
# CAN-SPAM-required physical mailing address included in outreach email footers
OUTREACH_PHYSICAL_ADDRESS=219 E Michigan Ave, Suite F, Paw Paw, MI 49079
# Cooldown period (days) before a policy-blocked organizer email can be retried
POLICY_BLOCK_COOLDOWN_DAYS=7

# ── MailerLite Groups (additional) ───────────────────────────────────────────
# MailerLite group ID for organizer subscribers (onboarding automation)
MAILERLITE_ORGANIZERS_GROUP_ID=
# MailerLite group ID for "hot" lead segment
MAILERLITE_HOT_GROUP_ID=
# MailerLite group ID for "warm" lead segment
MAILERLITE_WARM_GROUP_ID=
# MailerLite group ID for "cold" lead segment
MAILERLITE_COLD_GROUP_ID=

# ── Feature Flags (additional) ───────────────────────────────────────────────
# Enable metro sync cron (keeps regional metro data current)
METRO_SYNC_ENABLED=false
# Enable organizer website enrichment during scraping (see also DISABLE_ORGANIZER_WEBSITE_ENRICHMENT)
WEBSITE_ENRICHMENT_ENABLED=true
# Enable weekly organizer analytics digest emails — default OFF
ORGANIZER_DIGEST_ENABLED=false
# Route sale detail enrichment through the backend cron instead of the legacy path
USE_BACKEND_SALE_ENRICHMENT=false
# Route the EstateSalesNet scraper through GitHub Actions instead of the in-process cron
USE_GH_ACTIONS_ESTATESALESNET=false
# Route the Facebook Marketplace scraper through GitHub Actions instead of the in-process cron (default true)
USE_GH_ACTIONS_FACEBOOKMARKETPLACE=true
# Route the GarageSaleFinder scraper through GitHub Actions instead of the in-process cron (default true)
USE_GH_ACTIONS_GARAGESALEFINDER=true
# Route the YellowPagesCA scraper through GitHub Actions instead of the in-process cron (default true)
USE_GH_ACTIONS_YELLOWPAGESCA=true

# ── Scraper Batch Tuning (GitHub Actions matrix scrapers) ────────────────────
# Batch size for EstateSalesNet sale-detail enrichment cron
ESN_DETAIL_BATCH_SIZE=75
# Which batch index (0-based) this scraper run should process, for sharded GitHub Actions matrix jobs
SCRAPER_BATCH_INDEX=0
# Total number of batches the scrape job is sharded into, for GitHub Actions matrix jobs
SCRAPER_BATCH_COUNT=1
# Max queue size processed per scraper run (Foursquare/HERE places scrapers)
SCRAPER_QUEUE_LIMIT=50
# Chunk index for the EstateSalesNet scraper's chunked run mode
SCRAPER_CHUNK=
# Total number of chunks for the EstateSalesNet scraper's chunked run mode
SCRAPER_TOTAL_CHUNKS=
# Organizer ID to attribute EstateSalesNet-sourced sales to
ESTATESALESNET_ORGANIZER_ID=
# Organizer ID to attribute Facebook Events-sourced sales to
FB_EVENTS_ORGANIZER_ID=
# Set "true" to run the Facebook Events scraper across all supported metros instead of one
FB_EVENTS_ALL_METROS=false
# Organizer ID to attribute Facebook Marketplace-sourced sales to
FB_MARKETPLACE_ORGANIZER_ID=
# Batch size for the organizer contact backfill controller
ORG_CONTACT_BACKFILL_BATCH_SIZE=
# Max sales processed per run of the organizer website address enrichment cron
WEBSITE_SCRAPE_BATCH_SIZE=1000
# Batch size for the AI listing enrichment backfill controller
AI_ENRICHMENT_BATCH_SIZE=50
# Set to the literal string "YES" to actually apply changes from the mistyped-sales reclassification script (default dry-run)
RECLASSIFY_CONFIRM_APPLY=

# ── Misc Application Config ───────────────────────────────────────────────────
# Cloudinary cloud name used by the photo retention cron (separate read from CLOUDINARY_CLOUD_NAME)
CLOUDINARY_NAME=
# Frontend URL used for Stripe checkout/portal return links — falls back to FRONTEND_URL
NEXT_PUBLIC_FRONTEND_URL=https://finda.sale
# Site URL used for unsubscribe links in reminder emails — falls back to https://finda.sale
NEXT_PUBLIC_SITE_URL=https://finda.sale
# Canonical site URL used by the IndexNow service — falls back to https://finda.sale
SITE_URL=https://finda.sale
# Google Business Profile review link included in review-request emails
GBP_REVIEW_URL=
# Email address that receives deliverability/quota alert notifications
QUOTA_ALERT_EMAIL=
# Redis connection URL — enables distributed rate limiting when set (falls back to in-memory otherwise)
REDIS_URL=
# SES verified from-address — fallback used when GMAIL_FROM_EMAIL is unset
SES_FROM_EMAIL=
# SMTP username — presence gates whether notificationController attempts SMTP delivery
SMTP_USERNAME=
# User ID attributed as the author for system-generated encyclopedia entries — falls back to the string "system"
SYSTEM_USER_ID=
# Log verbosity for scraper services — set to "debug" for verbose scraper logging
LOG_LEVEL=
# Grace period (days) before a lapsed paid tier is downgraded
TIER_GRACE_DAYS=7
# Max age (hours) before a stale unpublished draft sale is auto-cleaned up
DRAFT_CLEANUP_MAX_AGE_HOURS=
# Max number of sales that can be "Featured"-boosted concurrently
MAX_FEATURED_BOOSTS=5

# ── Railway Platform (auto-injected — informational only, do not set manually) ──
# Railway backend service URL — used by scraper scripts as the ingest callback target; falls back to localhost:3001 in dev
RAILWAY_BACKEND_URL=
# Railway's public-facing domain for this deployment — auto-injected by Railway, used to build absolute outreach URLs
RAILWAY_PUBLIC_DOMAIN=
# Git commit SHA of the deployed build — auto-injected by Railway, surfaced in the /health endpoint for deploy verification
RAILWAY_GIT_COMMIT_SHA=
# ── Scraper / Search Providers (additional) ──────────────────────────────────
# Master kill switch for the in-process scraper cron — must be "true" to run any scrapers
SCRAPER_ENABLED=false
# Searlo API key — used by the Facebook Events search scraper source
SEARLO_API_KEY=
