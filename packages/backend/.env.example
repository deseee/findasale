# ─────────────────────────────────────────────────────────────────────────
# Required-vs-optional classification pass (health-scout dispatch, 2026-09-27)
# Tag on each KEY= line below:
#   [REQUIRED]   — code fails hard, or a core feature breaks, without this set
#   [OPTIONAL]   — an integration that already fails soft (console.warn/return
#                  null-ish) when this is unset; safe to leave blank in a new env
#   [VERIFY]     — no `process.env.<KEY>` reference found under packages/backend/src
#                  in this pass; likely read via packages/database, packages/scripts,
#                  a config object with a different lookup, or genuinely dead —
#                  needs a human look before deleting, not auto-removed
# Classification was done with a text-window heuristic (grep + surrounding-lines
# check for fail-soft phrasing), not a full static-analysis pass — treat tags as a
# strong first-pass signal, not a guarantee. This is what closed the 153→165-key
# drift flagged in the two most recent weekly health-scout reports.
# ─────────────────────────────────────────────────────────────────────────

PORT=5000  # [REQUIRED]

# Local dev: http://localhost:3000 | Production: https://finda.sale
FRONTEND_URL=https://finda.sale  # [REQUIRED]

# Comma-separated. Local dev: http://localhost:3000 | Production: https://finda.sale
ALLOWED_ORIGINS=https://finda.sale  # [REQUIRED]

JWT_SECRET=your_key_here  # [REQUIRED]
DATABASE_URL=your_key_here  # [REQUIRED]
# Direct connection for migrations (Railway)
DIRECT_URL=your_key_here  # [VERIFY]
# Local dev database (optional)
LOCAL_DATABASE_URL=your_key_here  # [VERIFY]

STRIPE_SECRET_KEY=your_key_here  # [REQUIRED]
STRIPE_PUBLISHABLE_KEY=your_key_here  # [VERIFY]
# Get from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=your_key_here  # [OPTIONAL]
# Get from Stripe Dashboard → Webhooks → your billing endpoint → Signing secret
STRIPE_BILLING_WEBHOOK_SECRET=your_key_here  # [OPTIONAL]
# Get from Stripe Dashboard → Webhooks → your Connect endpoint → Signing secret
STRIPE_CONNECT_WEBHOOK_SECRET=your_key_here  # [OPTIONAL]
# Get from Stripe Dashboard → Products → your PRO/TEAMS plan → Prices
STRIPE_PRO_MONTHLY_PRICE_ID=price_...  # [REQUIRED]
STRIPE_TEAMS_MONTHLY_PRICE_ID=price_...  # [REQUIRED]
# Get from Stripe Dashboard → Products → generic item product → ID
STRIPE_GENERIC_ITEM_PRODUCT_ID=prod_...  # [VERIFY]
# Get from Stripe Dashboard → Products → Hunt Pass subscription → Price ID
STRIPE_HUNT_PASS_PRICE_ID=price_...  # [VERIFY]
# Optional: coupon ID for trial periods (Stripe Dashboard → Coupons)
STRIPE_TRIAL_COUPON_ID=  # [VERIFY]
# Set to "true" to use Stripe Terminal in simulated mode (dev/staging only — never in production)
NEXT_PUBLIC_STRIPE_TERMINAL_SIMULATED=false  # [VERIFY]

# ── Square (2026-09-07 migration; previously undocumented here despite being read by
# utils/square.ts, squareConnectService.ts, squareVendorBoothCartService.ts, and, as of
# 2026-09-13, squareBillingService.ts for Plan B recurring billing) ─────────────────────
# Personal Access Token for FindA.Sale's OWN platform Square account -- platform-level
# calls only (getSquarePlatformClient() in utils/square.ts). NEVER used to charge on an
# organizer's behalf. Get from Square Developer Console → your app → Credentials.
SQUARE_ACCESS_TOKEN=your_square_platform_access_token_here  # [REQUIRED]
# Square Developer Console app id/secret -- used for the organizer-facing Connect-equivalent
# OAuth flow (squareConnectService.ts), NOT the platform client above.
SQUARE_APPLICATION_ID=your_square_application_id_here  # [REQUIRED]
SQUARE_APPLICATION_SECRET=your_square_application_secret_here  # [REQUIRED]
# 'sandbox' (default if unset) or 'production' -- must be the exact literal 'production' to
# opt in; every other value (including unset/typo) fails toward the safe sandbox default.
SQUARE_ENVIRONMENT=sandbox  # [REQUIRED]
# FindA.Sale's own platform Square location id (Developer Console → Locations). Used by
# squareVendorBoothCartService.ts (hub-owner revenue-share legs) and, as of 2026-09-13,
# squareBillingService.ts (PRO/TEAMS + Hunt Pass recurring billing charges) -- same value
# as the frontend's NEXT_PUBLIC_SQUARE_PLATFORM_LOCATION_ID (packages/frontend/.env.local).
SQUARE_PLATFORM_LOCATION_ID=your_square_platform_location_id_here  # [REQUIRED]
# Square webhook signature key + the notification URL registered for it (Developer Console
# → Webhooks) -- used by squareWebhookController.ts.
SQUARE_WEBHOOK_SIGNATURE_KEY=your_square_webhook_signature_key_here  # [OPTIONAL]
SQUARE_WEBHOOK_NOTIFICATION_URL=https://api.finda.sale/api/square/webhook  # [OPTIONAL]

# Real Square Sandbox ADR (2026-09-17) -- FindA.Sale's platform-level Square SANDBOX
# credential set (Developer Console -> your app -> Credentials -> Sandbox tab). Used ONLY
# by isTestTransaction + X-QA-Bypass gated QA test-transaction requests
# (getSquareSandboxClient/getSquareSandboxLocationId, utils/square.ts;
# createAndCaptureSandboxPayment, squarePosPaymentAdapter.ts) -- NEVER by any real charge,
# and never derived from SQUARE_ENVIRONMENT above.
SQUARE_SANDBOX_ACCESS_TOKEN=your_square_sandbox_access_token_here  # [REQUIRED]
# Sandbox Application ID for the same app -- not read by the server-side charge call itself
# (that only needs the token + location id above/below), captured for a future sandbox-mode
# Web Payments SDK toggle if/when one is wired up client-side.
SQUARE_SANDBOX_APPLICATION_ID=your_square_sandbox_application_id_here  # [REQUIRED]
# The default Sandbox test account's default Location ID (Sandbox Square Dashboard ->
# Locations, or a one-time ListLocations call using the sandbox access token above).
SQUARE_SANDBOX_LOCATION_ID=your_square_sandbox_location_id_here  # [REQUIRED]

# Finix sandbox (2026-09-18) -- evaluated alternative/supplement to Square, not yet
# approved for production. Get sandbox credentials from
# https://finix.payments-dashboard.com/signup (Developer -> Create API Key). See
# finixConnectService.ts and claude_docs/feature-notes/finix-sandbox-smoke-test-results-2026-09-18.md
FINIX_USERNAME=your_finix_sandbox_username_here  # [OPTIONAL]
FINIX_PASSWORD=your_finix_sandbox_password_here  # [OPTIONAL]
FINIX_ENVIRONMENT=sandbox  # [OPTIONAL]
FINIX_SANDBOX_API_BASE_URL=https://finix.sandbox-payments-api.com  # [REQUIRED]
FINIX_PRODUCTION_API_BASE_URL=  # [OPTIONAL]
FINIX_SANDBOX_PROCESSOR=DUMMY_V1  # [REQUIRED]
FINIX_APPLICATION_ID=your_finix_application_id_here  # [VERIFY]
FINIX_MERCHANT_ID=your_finix_merchant_id_here  # [VERIFY]
FINIX_MERCHANT_IDENTITY_ID=your_finix_merchant_identity_id_here  # [VERIFY]

RESEND_API_KEY=your_key_here  # [REQUIRED]
RESEND_FROM_EMAIL=example@resend.dev  # [REQUIRED]
# Read-enabled Resend key (logs/emails API) used by the daily email-delivery-health check (M2).
RESEND_ADMIN_API_KEY=your_read_key_here  # [VERIFY]

# Email recipient policy (S937): we NEVER send to our own domain zone — any recipient at
# finda.sale or *.finda.sale (e.g. scraped placeholders scraper+slug@system.finda.sale) is
# filtered at the email rails (suppressionService.isEmailDomainBlocked). The ONLY allowed
# exception is the contact-form support inbox (SUPPORT_EMAIL, default support@finda.sale).
# If you ever stand up another REAL internal finda.sale inbox you want to email FROM the app
# (e.g. info@ or patrick@), add it here as a comma-separated allowlist — otherwise it will be
# blocked by the zone filter. Leave blank if unused.
SENDABLE_FINDA_SALE_ADDRESSES=  # [REQUIRED]
SUPPORT_EMAIL=support@finda.sale  # [REQUIRED]

# MailerLite — organizer onboarding automation
# API token (used by MailerLite SDK): MailerLite → Integrations → MailerLite API
MAILERLITE_API_TOKEN=your_key_here  # [VERIFY]
# API key (used by direct HTTP requests in some services — same credential, different header)
MAILERLITE_API_KEY=your_key_here  # [REQUIRED]
# Get from: MailerLite → Subscribers → Groups → your shopper group → ID in URL
MAILERLITE_SHOPPERS_GROUP_ID=your_group_id_here  # [OPTIONAL]

TWILIO_ACCOUNT_SID=your_key_here  # [REQUIRED]
TWILIO_AUTH_TOKEN=your_key_here  # [REQUIRED]
TWILIO_PHONE_NUMBER=+15555555555  # [REQUIRED]

CLOUDINARY_CLOUD_NAME=your_cloud_name_here  # [REQUIRED]
CLOUDINARY_API_KEY=your_api_key_here  # [REQUIRED]
CLOUDINARY_API_SECRET=your_api_secret_here  # [REQUIRED]
# Used for bandwidth cost tracking — average compressed image size in KB
CLOUDINARY_AVG_IMAGE_SIZE_KB=200  # [REQUIRED]

# ── AI Tagging — CB1 (Cloud AI path, preferred) ───────────────────────────────────────
# Google Cloud Vision API: console.cloud.google.com → APIs → Vision API → Credentials → API Key
GOOGLE_VISION_API_KEY=your_key_here  # [REQUIRED]
# Anthropic API: console.anthropic.com → API Keys → Create key
ANTHROPIC_API_KEY=your_key_here  # [REQUIRED]
# Max AI spend per billing cycle in USD before fallback to local model
AI_COST_CEILING_USD=0.25  # [REQUIRED]
# Local AI fallback via Ollama (optional — omit to disable)
OLLAMA_URL=http://localhost:11434  # [REQUIRED]
OLLAMA_VISION_MODEL=llava  # [REQUIRED]
# Reverse-Image Product Index (ADR 2026-07-01) — self-hosted Marqo-Ecommerce-B
# embedding service. Default OFF until the Open Images reference corpus is built
# (scripts/open-images/extract_open_images.py + ingestOpenImagesCorpus.ts).
# CATALOG_MATCH_ENABLED=true
# MARQO_EMBED_URL=https://<your-marqo-embed-service>.up.railway.app

# Google Vision Web Detection — hard-gated, default OFF (ADR-web-detection-hard-gating-2026-07-01)
# Do NOT set to true until the GCP Console quota check in that ADR's "Flagged for Patrick"
# section has been done. Three independent stops: kill switch below, dedicated monthly cost
# ceiling, dedicated daily call cap — see aiCostTracker.ts for details.
# WEB_DETECTION_ENABLED=true
# WEB_DETECTION_COST_CEILING_USD=5
# WEB_DETECTION_DAILY_CAP=200

# eBay searchByImage catalog-match evidence — free (client-credentials Browse quota), default OFF
# (ADR-ebay-searchbyimage-tagging-2026-07-02). Kill switch below + a daily CALL cap that protects
# the shared ~5k/day Browse quota price comps also use. No dollar ceiling — the call costs nothing.
# PRODUCTION-ONLY (searchByImage has no Sandbox). Reuses EBAY_CLIENT_ID/SECRET already configured.
# EBAY_IMAGE_SEARCH_ENABLED=true
# EBAY_IMAGE_SEARCH_DAILY_CAP=500
# PWA Push Notifications (web-push)
# Generate keys: npx web-push generate-vapid-keys
# Add NEXT_PUBLIC_VAPID_PUBLIC_KEY to frontend .env too
VAPID_PUBLIC_KEY=  # [OPTIONAL]
VAPID_PRIVATE_KEY=  # [OPTIONAL]
VAPID_CONTACT_EMAIL=admin@finda.sale  # [OPTIONAL]

# Sentry error monitoring — get DSN from sentry.io → project settings
SENTRY_DSN=  # [OPTIONAL]
# Sentry auth token for source map uploads (sentry.io → Settings → Auth Tokens)
SENTRY_AUTH_TOKEN=  # [VERIFY]

# ── Integrations ────────────────────────────────────────────────────────
# Google Places API — used for address autocomplete
GOOGLE_PLACES_API_KEY=  # [OPTIONAL]
# eBay marketplace notifications (deletion endpoint must be registered in eBay Developer portal)
EBAY_DELETION_ENDPOINT_URL=  # [OPTIONAL]
EBAY_VERIFICATION_TOKEN=  # [OPTIONAL]
# OSRM self-hosted routing (optional — for Treasure Trails distance calculations)
OSRM_API_URL=  # [REQUIRED]

# ── Internal API Authentication ──────────────────────────────────────────
# Shared secret for internal routes (requireSecret middleware, x-internal-secret header)
# Used by: /api/internal/scraper/enrich-backfill, licensing scrapers, outreach trigger
# Railway-only secret — not needed for local dev. Set in Railway env vars + GitHub Actions secrets.
OUTREACH_SECRET=your_secret_here  # [REQUIRED]
# Shared key for GitHub Actions scraper ingestion (x-scraper-key header)
# Used by: /api/internal/scraper/ingest, geocoding, sale detail enrichment
# Railway-only secret — not needed for local dev. Set in Railway env vars + GitHub Actions secrets.
INTERNAL_SCRAPER_KEY=your_key_here  # [REQUIRED]

# Shared secret for on-demand ISR revalidation (ADR 2026-07-11).
# Backend sends this to the frontend's POST /api/revalidate to invalidate
# /sales/[id] and /city/[slug] pages on real data changes instead of waiting
# on the blanket time-based ISR fallback. Must match the same var set on Vercel.
# NEW as of 2026-07-11 — not yet set anywhere. Generate a random value and set
# it on both Railway (this var) and Vercel (frontend) before this is testable end-to-end.
REVALIDATE_SECRET=your_secret_here  # [REQUIRED]

# ── Security ─────────────────────────────────────────────────────────────
# Comma-separated IPs exempt from rate limiting (e.g. Railway health checks)
RATE_LIMIT_WHITELIST_IPS=  # [REQUIRED]

# ── Region Configuration ────────────────────────────────────────────────
# Allows the app to serve any city/region by changing env vars at deployment time.
# Defaults to Grand Rapids, MI for existing deployments.
DEFAULT_CITY=Grand Rapids  # [VERIFY]
DEFAULT_STATE=Michigan  # [VERIFY]
DEFAULT_STATE_ABBREV=MI  # [VERIFY]
DEFAULT_LAT=42.9619  # [VERIFY]
DEFAULT_LNG=-85.6789  # [VERIFY]
DEFAULT_RADIUS_MILES=25  # [VERIFY]
DEFAULT_COUNTY=Kent County  # [VERIFY]
DEFAULT_TIMEZONE=America/Detroit  # [VERIFY]

# ── Search Engine Indexing ───────────────────────────────────────────────
# IndexNow API key — must match /public/fa3d9e1b8c2047a6d5f3e9b1c4a87d20.txt on the frontend
INDEX_NOW_KEY=fa3d9e1b8c2047a6d5f3e9b1c4a87d20  # [OPTIONAL]

# ── Auth (additional) ─────────────────────────────────────────────────────────
JWT_REFRESH_SECRET=                    # Must be set — distinct from JWT_SECRET. If absent, refresh tokens fall back to JWT_SECRET (defeats token rotation)  # [REQUIRED]

# ── eBay Integration ─────────────────────────────────────────────────────────
EBAY_CLIENT_ID=  # [REQUIRED]
EBAY_CLIENT_SECRET=  # [REQUIRED]
EBAY_OAUTH_REDIRECT_URI=  # [OPTIONAL]
EBAY_API_DAILY_LIMIT=500              # Daily cap on eBay API calls per cron  # [REQUIRED]
EBAY_PROXY_SECRET=                    # Shared secret for eBay proxy service  # [REQUIRED]

# ── Gmail Outreach Rail ───────────────────────────────────────────────────────
GMAIL_CLIENT_ID=  # [REQUIRED]
GMAIL_CLIENT_SECRET=  # [REQUIRED]
GMAIL_REFRESH_TOKEN=                  # Outreach account refresh token  # [REQUIRED]
GMAIL_MAILBOX_REFRESH_TOKEN=          # Support mailbox refresh token  # [REQUIRED]
GMAIL_FROM_EMAIL=  # [REQUIRED]
GMAIL_DAILY_HARD_LIMIT=100           # Max emails/day via Gmail rail  # [REQUIRED]

# ── Email Feature Flags ───────────────────────────────────────────────────────
OUTREACH_ENABLED=false               # Set true to enable organizer outreach emails  # [REQUIRED]
EMAIL_DISCOVERY_ENABLED=false        # Set true to enable email discovery scraper  # [VERIFY]

# ── Third-Party Scrapers ─────────────────────────────────────────────────────
FB_MARKETPLACE_PROXY_URL=            # Proxy URL for Facebook Marketplace scraper  # [OPTIONAL]
FB_MARKETPLACE_PROXY_TOKEN=          # Auth token for FB Marketplace proxy  # [OPTIONAL]
DISCOGS_TOKEN=                       # Discogs API token for vinyl/music comps  # [REQUIRED]
PRICECHARTING_API_TOKEN=              # PriceCharting API token (t= param, free signup at pricecharting.com/api) for priceChartingService.ts's video game/card/comic/toy pricing lookups -- no fallback, lookups are disabled (return null, one-time console.warn) if unset. Confirmed 2026-09-13 that PriceCharting's API hard-fails with HTTP 400 on every request with no token at all.  # [OPTIONAL]
GSA_API_KEY=                          # api.data.gov key for GSA Auctions pricing adapter (free signup, api.data.gov/signup) -- falls back to DEMO_KEY if unset  # [OPTIONAL]
ETSY_API_KEY=                         # Etsy Open API v3 keystring for the Etsy pricing adapter (free signup, developer.etsy.com -> Your Apps) -- no fallback key, adapter reports itself unconfigured if unset. Bare keystring only, NOT keystring:sharedsecret (that colon-joined form is for OAuth-scoped shop-management endpoints, not this public search endpoint).  # [REQUIRED]
FOURSQUARE_API_KEY=                  # Foursquare API for venue data  # [REQUIRED]
BRAVE_API_KEY=                       # Brave Search API for scraper enrichment  # [REQUIRED]

# ── AI / ML ──────────────────────────────────────────────────────────────────
ANTHROPIC_MODEL=claude-haiku-4-5-20251001   # Model string override (defaults to haiku)  # [REQUIRED]

# ── Infrastructure ────────────────────────────────────────────────────────────
BACKEND_URL=                         # Internal URL for backend (used in scraper callbacks)  # [REQUIRED]
EBTH_WORKER_URL=                     # EBTH worker service URL  # [REQUIRED]

# ── Feature / Scraper Flags ───────────────────────────────────────────────────
CATEGORY_SYNC_ENABLED=false          # Enable eBay category sync cron  # [OPTIONAL]
DISABLE_ORGANIZER_WEBSITE_ENRICHMENT=false   # Disable website enrichment during scraping  # [OPTIONAL]
# ── Stripe Pricing / Connect (additional) ────────────────────────────────────
# Test-mode secret key — used by scripts/tests that must not touch live Stripe (Stripe Dashboard → Test mode → API keys)
STRIPE_TEST_SECRET_KEY=  # [REQUIRED]
# Get from Stripe Dashboard → Products → PRO plan → Prices → Annual price
STRIPE_PRO_ANNUAL_PRICE_ID=  # [REQUIRED]
# Get from Stripe Dashboard → Products → TEAMS plan → Prices → Annual price
STRIPE_TEAMS_ANNUAL_PRICE_ID=  # [REQUIRED]
# Get from Stripe Dashboard → Products → TEAMS plan → Prices → Per-seat price
STRIPE_TEAMS_SEAT_PRICE_ID=  # [OPTIONAL]
# Set to "true" to allow real (non-simulated) Stripe Connect transfers to organizers
STRIPE_CONNECT_LIVE_TRANSFERS=false  # [OPTIONAL]
# Stripe Connect partner/platform ID (Stripe Dashboard → Connect → Settings)
STRIPE_PARTNER_ID=  # [REQUIRED]
# Backend-side mirror of NEXT_PUBLIC_STRIPE_TERMINAL_SIMULATED — set "true" only in dev/staging
STRIPE_TERMINAL_SIMULATED=false  # [REQUIRED]
# Direct-charges migration (2026-08-08) staged-rollout gate: comma-separated Organizer.id
# list opted into Direct charges (the connected account itself becomes the merchant of
# record / bears card-network liability, instead of the platform). Unset/empty = nobody
# routed to Direct charges yet — all charges stay on the existing destination-charge shape.
# Even an allowlisted organizer is only actually routed Direct if Stripe also reports the
# account as eligible (card_payments capability active + controller.losses.payments ===
# 'stripe') — see stripeConnectService.shouldUseDirectCharge/isDirectChargeEligible.
STRIPE_DIRECT_CHARGES_ORGANIZER_ALLOWLIST=  # [OPTIONAL]
# findasale-hacker fix (2026-08-09): both flags below were missing from this file entirely
# (confirmed via grep this session) despite gating real money-moving code paths in
# refundService.ts / stripeController.ts -- documented here so an operator can find them.
# Set to "true" to let executeVerifiedRefund's organizer clawback (reverse_transfer +
# refund_application_fee on a DESTINATION-charge refund) actually move money. Default OFF.
STRIPE_REFUND_LIVE_CLAWBACK=false  # [REQUIRED]
# Set to "true" to let the charge.dispute.closed (lost) webhook handler actually reverse the
# platform -> organizer Transfer for a lost DESTINATION-charge dispute. Default OFF. Confirmed
# via Railway MCP (2026-08-09) that this variable does not exist in the `backend` production
# service yet -- unset resolves to OFF, same as explicit "false".
STRIPE_DISPUTE_LIVE_CLAWBACK=false  # [REQUIRED]

# ── Security / Webhooks (additional) ─────────────────────────────────────────
# Shared secret that lets QA bypass rate limiting on auth endpoints during automated testing — Railway/CI only, never local
QA_RATE_LIMIT_BYPASS_SECRET=  # [OPTIONAL]
# Get from Resend Dashboard → Webhooks → your endpoint → Signing secret (used for delivery/bounce webhook verification)
RESEND_WEBHOOK_SECRET=  # [OPTIONAL]
# WebAuthn/passkey Relying Party ID — must match the site's registrable domain (e.g. finda.sale)
WEBAUTHN_RP_ID=  # [REQUIRED]
# WebAuthn/passkey expected origin — full scheme+host (e.g. https://finda.sale)
WEBAUTHN_ORIGIN=  # [REQUIRED]
# Google service account credentials JSON (stringified) — used for model bakeoff / Vertex-style auth
GOOGLE_SERVICE_ACCOUNT_JSON=  # [OPTIONAL]
# eBay marketplace account deletion notifications — verification token (eBay Developer Portal → Notifications)
EBAY_NOTIFICATION_VERIFICATION_TOKEN=  # [OPTIONAL]
# eBay marketplace account deletion notifications — registered callback endpoint URL
EBAY_NOTIFICATION_ENDPOINT_URL=  # [REQUIRED]

# ── AI Grounding — Cost-Controlled Web-Grounded Enrichment ───────────────────
# Master kill switch for the grounding pipeline (visual + text). Default OFF.
GROUNDING_ENABLED=false  # [REQUIRED]
# Hard monthly spend ceiling in USD before grounding auto-disables
GROUNDING_COST_CEILING_USD=  # [REQUIRED]
# Max grounding calls allowed per day regardless of spend
GROUNDING_DAILY_CAP=  # [REQUIRED]
# Confidence threshold below which an item is escalated to a stronger grounding pass
GROUNDING_ESCALATE_BELOW=  # [OPTIONAL]
# Max USD allowed to be spent grounding a single item before skipping
GROUNDING_PER_ITEM_COST_CEILING_USD=  # [REQUIRED]
# Skip re-grounding items whose existing confidence is already above this value
GROUNDING_REGROUND_SKIP_ABOVE=  # [OPTIONAL]
# Percentage (0-100) of eligible items rolled into the grounding pipeline — for staged rollout
GROUNDING_ROLLOUT_PCT=  # [REQUIRED]
# Enable text-based grounding specifically (title/description enrichment), independent of visual grounding
GROUNDING_TEXT_ENABLED=false  # [OPTIONAL]
# Model string used for the higher-cost/higher-accuracy text grounding pass
GROUNDING_TEXT_PREMIUM_MODEL=  # [REQUIRED]
# Model string used for the lower-cost text grounding pass (value extraction)
GROUNDING_TEXT_VALUE_MODEL=  # [REQUIRED]
# Model string used specifically for structured value extraction during grounding
GROUNDING_VALUE_EXTRACTOR_MODEL=  # [REQUIRED]
# Enable visual (image-based) grounding specifically, independent of text grounding
GROUNDING_VISUAL_ENABLED=false  # [OPTIONAL]
# Google Vision Web Detection — hard-gated feature flag, default OFF (see ADR-web-detection-hard-gating-2026-07-01)
WEB_DETECTION_ENABLED=false  # [REQUIRED]
# Monthly spend ceiling in USD for Web Detection API calls
WEB_DETECTION_COST_CEILING_USD=5  # [REQUIRED]
# Max Web Detection API calls allowed per day
WEB_DETECTION_DAILY_CAP=200  # [REQUIRED]

# ── Curio (resale-value scanner) -- curio-api-adr-2026-07-17.md, Phase 1 ───────────────────────
# Fully separate cost/rate pool from the AI_DAILY_CALL_CAP / WEB_DETECTION_* pools above --
# never shares state with them. Defaults below match the Patrick-approved 2026-07-17 numbers;
# only set these if overriding.
# Per-user Curio scans allowed per day
CURIO_DAILY_SCAN_CAP=3  # [REQUIRED]
# All-users-combined Curio scans allowed per day
CURIO_GLOBAL_DAILY_SCAN_CAP=12  # [REQUIRED]
# Hard monthly $ stop for Curio's Vision+Haiku spend
CURIO_MONTHLY_BUDGET_CEILING_USD=9.00  # [REQUIRED]
# % of CURIO_GLOBAL_DAILY_SCAN_CAP used before remaining scans that day route to the cheaper
# degraded (Label-Detection-only, no Haiku) pipeline instead of a hard 429
CURIO_DEGRADED_MODE_THRESHOLD_PCT=80  # [REQUIRED]

# ── AI / ML — Additional Providers ────────────────────────────────────────────
# Google Gemini API key — used by model bakeoff service as an alternate vision/text model
GEMINI_API_KEY=  # [OPTIONAL]
# OpenRouter API key — used by model bakeoff service to access multiple hosted models via one API
OPENROUTER_API_KEY=  # [REQUIRED]

# ── Pricing / Comp Data Providers ────────────────────────────────────────────
# Keepa API key — Amazon price history/comps for item valuation
KEEPA_API_KEY=  # [OPTIONAL]
# GoUPC API key — barcode/UPC lookup for item identification
GOUPC_API_KEY=  # [OPTIONAL]
# Yelp API key — used for venue/organizer enrichment
YELP_API_KEY=  # [OPTIONAL]
# ScaleSERP API key — search engine results API used for price comp scraping
SCALESERP_API_KEY=  # [REQUIRED]
# HERE API key — places/geocoding provider used by run-here-places scraper
HERE_API_KEY=  # [REQUIRED]
# Socrata App Token — used for municipal open-data API rate limits (e.g. permit/business listings)
SOCRATA_APP_TOKEN=  # [REQUIRED]
# Searlo (Facebook Events search) requests-per-minute override — see search-facebook-events.ts for tuning notes
SEARLO_RPM=9  # [REQUIRED]

# ── Reverse-Image Product Index (Catalog Match) ──────────────────────────────
# Enable catalog-match embedding lookups — default OFF until the Open Images reference corpus is built
CATALOG_MATCH_ENABLED=false  # [REQUIRED]
# Self-hosted Marqo-Ecommerce-B embedding service URL, e.g. https://<your-marqo-embed-service>.up.railway.app
MARQO_EMBED_URL=  # [REQUIRED]
# Path to the candidates file used by the Open Images corpus ingestion script (scripts/open-images/extract_open_images.py)
OPEN_IMAGES_CANDIDATES_FILE=  # [REQUIRED]
# Path to the candidates file used by the Overture Places enrichment script (runOvertureEnrichment.ts)
OVERTURE_CANDIDATES_FILE=  # [REQUIRED]

# ── eBay Integration (additional) ────────────────────────────────────────────
# Enable matching by title as a fallback identifier when catalog IDs are unavailable
EBAY_MATCH_TITLE_AS_ID=false  # [REQUIRED]
# Daily cap on eBay searchByImage calls — protects the shared ~5k/day Browse quota (see ADR-ebay-searchbyimage-tagging-2026-07-02)
EBAY_IMAGE_SEARCH_DAILY_CAP=500  # [REQUIRED]
# Kill switch for eBay searchByImage catalog-match evidence — default OFF, production-only (no Sandbox support)
EBAY_IMAGE_SEARCH_ENABLED=false  # [REQUIRED]

# Daily cap on eBay price-comps Browse calls (organizer "AI Price Comps" feature, LIVE — NOT a
# kill switch). Protects the same shared ~5k/day Browse quota as EBAY_IMAGE_SEARCH_DAILY_CAP above.
# Sized generously (8x the image-search cap) so normal usage never trips it; only a breaker against
# a retry/loop bug. See Ops investigation 2026-07-18 (Prospector eBay Browse-API quota isolation).
EBAY_PRICE_COMPS_DAILY_CAP=4000  # [REQUIRED]

# Max registrations allowed per IP per 24h (independent of the 5/hr rolling window) --
# P0 fix 2026-07-19, closes the ~120/day-from-one-IP gap the hourly-only limit left open.
MAX_REGISTRATIONS_PER_DAY=20  # [REQUIRED]

# ── Outreach (additional) ─────────────────────────────────────────────────────
# From-address used for outreach sends — falls back to outreach@finda.sale
OUTREACH_FROM_EMAIL=  # [OPTIONAL]
# When set, redirects ALL outreach sends to this address instead of real recipients (test mode)
OUTREACH_TEST_EMAIL=  # [REQUIRED]
# Mailbox that receives outreach bounces — falls back to find@outreach.finda.sale
OUTREACH_BOUNCE_MAILBOX=  # [OPTIONAL]
# Date (YYYY-MM-DD) outreach warmup ramp began — used to compute the current daily send cap during ramp-up
OUTREACH_WARMUP_START_DATE=2026-05-06  # [REQUIRED]
# Max outreach emails allowed per day (post-warmup steady state)
OUTREACH_DAILY_CAP=75  # [REQUIRED]
# Set "true" to include Canadian organizers in outreach targeting (default excludes Canada)
OUTREACH_CANADA_ENABLED=false  # [REQUIRED]
# CAN-SPAM-required physical mailing address included in outreach email footers
OUTREACH_PHYSICAL_ADDRESS=219 E Michigan Ave, Suite F, Paw Paw, MI 49079  # [REQUIRED]
# Cooldown period (days) before a policy-blocked organizer email can be retried
POLICY_BLOCK_COOLDOWN_DAYS=7  # [REQUIRED]

# ── MailerLite Groups (additional) ───────────────────────────────────────────
# MailerLite group ID for organizer subscribers (onboarding automation)
MAILERLITE_ORGANIZERS_GROUP_ID=  # [OPTIONAL]
# MailerLite group ID for "hot" lead segment
MAILERLITE_HOT_GROUP_ID=  # [OPTIONAL]
# MailerLite group ID for "warm" lead segment
MAILERLITE_WARM_GROUP_ID=  # [OPTIONAL]
# MailerLite group ID for "cold" lead segment
MAILERLITE_COLD_GROUP_ID=  # [OPTIONAL]

# ── Feature Flags (additional) ───────────────────────────────────────────────
# Enable metro sync cron (keeps regional metro data current)
METRO_SYNC_ENABLED=false  # [OPTIONAL]
# Enable organizer website enrichment during scraping (see also DISABLE_ORGANIZER_WEBSITE_ENRICHMENT)
WEBSITE_ENRICHMENT_ENABLED=true  # [OPTIONAL]
# Enable weekly organizer analytics digest emails — default OFF
ORGANIZER_DIGEST_ENABLED=false  # [OPTIONAL]
# Route sale detail enrichment through the backend cron instead of the legacy path
USE_BACKEND_SALE_ENRICHMENT=false  # [OPTIONAL]
# Route the EstateSalesNet scraper through GitHub Actions instead of the in-process cron
USE_GH_ACTIONS_ESTATESALESNET=false  # [OPTIONAL]
# Route the Facebook Marketplace scraper through GitHub Actions instead of the in-process cron (default true)
USE_GH_ACTIONS_FACEBOOKMARKETPLACE=true  # [OPTIONAL]
# Route the GarageSaleFinder scraper through GitHub Actions instead of the in-process cron (default true)
USE_GH_ACTIONS_GARAGESALEFINDER=true  # [OPTIONAL]
# Route the YellowPagesCA scraper through GitHub Actions instead of the in-process cron (default true)
USE_GH_ACTIONS_YELLOWPAGESCA=true  # [OPTIONAL]
# Lever #4 (2026-07-15 Vercel ISR-write reduction): proactively revalidate a
# small, capped, deduped batch of /city/[slug] paths after each scraper run
# (see flushScraperRevalidation in services/scraper/index.ts). Set to
# 'false' to disable and fall back to pure lazy/time-based ISR. Default true.
POST_SCRAPE_REVALIDATION_ENABLED=true  # [OPTIONAL]

# ── Scraper Batch Tuning (GitHub Actions matrix scrapers) ────────────────────
# Batch size for EstateSalesNet sale-detail enrichment cron
ESN_DETAIL_BATCH_SIZE=75  # [REQUIRED]
# Which batch index (0-based) this scraper run should process, for sharded GitHub Actions matrix jobs
SCRAPER_BATCH_INDEX=0  # [REQUIRED]
# Total number of batches the scrape job is sharded into, for GitHub Actions matrix jobs
SCRAPER_BATCH_COUNT=1  # [REQUIRED]
# Max queue size processed per scraper run (Foursquare/HERE places scrapers)
SCRAPER_QUEUE_LIMIT=50  # [REQUIRED]
# Chunk index for the EstateSalesNet scraper's chunked run mode
SCRAPER_CHUNK=  # [REQUIRED]
# Total number of chunks for the EstateSalesNet scraper's chunked run mode
SCRAPER_TOTAL_CHUNKS=  # [REQUIRED]
# Organizer ID to attribute EstateSalesNet-sourced sales to
ESTATESALESNET_ORGANIZER_ID=  # [REQUIRED]
# Organizer ID to attribute Facebook Events-sourced sales to
FB_EVENTS_ORGANIZER_ID=  # [REQUIRED]
# Set "true" to run the Facebook Events scraper across all supported metros instead of one
FB_EVENTS_ALL_METROS=false  # [REQUIRED]
# Organizer ID to attribute Facebook Marketplace-sourced sales to
FB_MARKETPLACE_ORGANIZER_ID=  # [REQUIRED]
# Batch size for the organizer contact backfill controller
ORG_CONTACT_BACKFILL_BATCH_SIZE=  # [OPTIONAL]
# Max sales processed per run of the organizer website address enrichment cron
WEBSITE_SCRAPE_BATCH_SIZE=1000  # [REQUIRED]
# Batch size for the AI listing enrichment backfill controller
AI_ENRICHMENT_BATCH_SIZE=50  # [REQUIRED]
# Set to the literal string "YES" to actually apply changes from the mistyped-sales reclassification script (default dry-run)
RECLASSIFY_CONFIRM_APPLY=  # [REQUIRED]

# ── Misc Application Config ───────────────────────────────────────────────────
# Cloudinary cloud name used by the photo retention cron (separate read from CLOUDINARY_CLOUD_NAME)
CLOUDINARY_NAME=  # [REQUIRED]
# Frontend URL used for Stripe checkout/portal return links — falls back to FRONTEND_URL
NEXT_PUBLIC_FRONTEND_URL=https://finda.sale  # [OPTIONAL]
# Site URL used for unsubscribe links in reminder emails — falls back to https://finda.sale
NEXT_PUBLIC_SITE_URL=https://finda.sale  # [REQUIRED]
# Canonical site URL used by the IndexNow service — falls back to https://finda.sale
SITE_URL=https://finda.sale  # [OPTIONAL]
# Google Business Profile review link included in review-request emails
GBP_REVIEW_URL=  # [REQUIRED]
# Email address that receives deliverability/quota alert notifications
QUOTA_ALERT_EMAIL=  # [REQUIRED]
# Comma-separated list of internal/test account emails excluded from MRR reporting, e.g. you@example.com,test@example.com
INTERNAL_EMAILS_CSV=  # [REQUIRED]
# Forwarding target for the outreach mailbox bounce-cleanup script (scripts/outreach-mailbox-ops.js)
GMAIL_FORWARD_TO=  # [VERIFY]
# Local dev seeding only (packages/database/prisma/seed.ts, survivor-seed.ts) — never a real address in a committed file
ADMIN_SEED_EMAIL=you@example.com  # [VERIFY]
ADMIN_SEED_NAME=Admin  # [VERIFY]
TEST_ORGANIZER_EMAIL=test-organizer@example.com  # [VERIFY]
ADMIN_SEED_PASSWORD=  # [VERIFY]
# Redis connection URL — enables distributed rate limiting when set (falls back to in-memory otherwise)
REDIS_URL=  # [REQUIRED]
# SES verified from-address — fallback used when GMAIL_FROM_EMAIL is unset
SES_FROM_EMAIL=  # [REQUIRED]
# SMTP username — presence gates whether notificationController attempts SMTP delivery
SMTP_USERNAME=  # [OPTIONAL]
# User ID attributed as the author for system-generated encyclopedia entries — falls back to the string "system"
SYSTEM_USER_ID=  # [REQUIRED]
# Log verbosity for scraper services — set to "debug" for verbose scraper logging
LOG_LEVEL=  # [REQUIRED]
# Grace period (days) before a lapsed paid tier is downgraded
TIER_GRACE_DAYS=7  # [REQUIRED]
# Max age (hours) before a stale unpublished draft sale is auto-cleaned up
DRAFT_CLEANUP_MAX_AGE_HOURS=  # [REQUIRED]
# Max number of sales that can be "Featured"-boosted concurrently
MAX_FEATURED_BOOSTS=5  # [REQUIRED]

# ── Railway Platform (auto-injected — informational only, do not set manually) ──
# Railway backend service URL — used by scraper scripts as the ingest callback target; falls back to localhost:3001 in dev
RAILWAY_BACKEND_URL=  # [REQUIRED]
# Railway's public-facing domain for this deployment — auto-injected by Railway, used to build absolute outreach URLs
RAILWAY_PUBLIC_DOMAIN=  # [OPTIONAL]
# Git commit SHA of the deployed build — auto-injected by Railway, surfaced in the /health endpoint for deploy verification
RAILWAY_GIT_COMMIT_SHA=  # [REQUIRED]
# ── Scraper / Search Providers (additional) ──────────────────────────────────
# Master kill switch for the in-process scraper cron — must be "true" to run any scrapers
SCRAPER_ENABLED=false  # [REQUIRED]
# Searlo API key — used by the Facebook Events search scraper source
SEARLO_API_KEY=  # [REQUIRED]
