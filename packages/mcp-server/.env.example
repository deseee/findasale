# MCP Server Configuration

# Backend API URL (prod: https://api.finda.sale, local: http://localhost:3001)
BACKEND_URL=https://api.finda.sale

# Server port (default 3003)
PORT=3003

# Public origin used in discovery documents (server card, AI catalog, mcp.json)
MCP_PUBLIC_ORIGIN=https://mcp.finda.sale

# All MCP HTTP requests allowed per IP per minute (default 120). Per-tool limits are in src/lib/rateLimiter.ts.
RATE_LIMIT_MAX_REQUESTS=120

# Not used (kept for the existing Railway variable; the window is fixed at 60 seconds)
RATE_LIMIT_WINDOW_MS=60000

# Node environment
NODE_ENV=production
