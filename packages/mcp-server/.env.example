# MCP Server Configuration

# Backend API URL (prod: https://api.finda.sale, local: http://localhost:3001)
BACKEND_URL=https://api.finda.sale

# Server port (default 3003)
PORT=3003

# Rate limiting window in milliseconds (default 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Max requests per window (not used in current implementation)
RATE_LIMIT_MAX_REQUESTS=100

# Node environment
NODE_ENV=production
